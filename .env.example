# Copy to .env.local for local development. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real values.

# Supabase Postgres through the transaction pooler (port 6543), as the
# least-privilege role created by supabase/migrations/0001_anylearn.sql.
# Leave unset to run with the bundled sample courses only.
DATABASE_URL=postgresql://anylearn_plugin_app.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Supabase Storage (S3-compatible) for course thumbnails.
# Dashboard → Storage → S3 Connection → New access key.
# Optional: without it, thumbnails are rendered on demand at /api/thumbnail/<id>.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_STORAGE_BUCKET=anylearn-plugin

# Public URL of the app. Optional on Vercel (detected automatically).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Safety valve: maximum new courses per hour across the whole app.
MAX_COURSES_PER_HOUR=300

# Optional: hosts add_image may download from (default: ChatGPT file hosts).
# ANYLEARN_IMAGE_HOSTS=oaiusercontent.com,openai.com,chatgpt.com,oaistatic.com
